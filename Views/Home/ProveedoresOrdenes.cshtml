<!-- Modal Nuevo Proveedor -->
<div class="modal fade" id="modalNuevoProveedor" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">Registrar Proveedor</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="mb-3">
                    <label class="form-label fw-semibold">Razón Social</label>
                    <input type="text" class="form-control" placeholder="Ej: Distribuidora Mayorista S.A." />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">CUIT</label>
                    <input type="text" class="form-control" placeholder="30-XXXXXXXX-X" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Teléfono</label>
                    <input type="text" class="form-control" placeholder="011-XXXX-XXXX" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-semibold">Email</label>
                    <input type="email" class="form-control" placeholder="ventas@proveedor.com.ar" />
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-dark rounded-pill px-4" data-bs-dismiss="modal" onclick="alert('Proveedor registrado.')">Guardar</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nueva Orden de Compra -->
<div class="modal fade" id="modalNuevaOrden" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title">Emitir Orden de Compra</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body p-4">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Proveedor</label>
                        <select class="form-select">
                            <option>Distribuidora Quilmes S.A.</option>
                            <option>Molinos del Sur S.R.L.</option>
                            <option>Lácteos La Serenísima S.A.</option>
                            <option>Química Limpia S.A.</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Sucursal de Destino</label>
                        <select class="form-select">
                            <option>Central</option>
                            <option>Sucursal Norte</option>
                            <option>Sucursal Sur</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label fw-semibold">Producto</label>
                        <select class="form-select">
                            <option>Cerveza Lager 1L</option>
                            <option>Leche Entera 1L</option>
                            <option>Fideos Espagueti 500g</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Cantidad</label>
                        <input type="number" class="form-control" value="100" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label fw-semibold">Costo Unitario ($)</label>
                        <input type="number" class="form-control" value="1650.00" />
                    </div>
                    <div class="col-12">
                        <label class="form-label fw-semibold">Observaciones</label>
                        <input type="text" class="form-control" placeholder="Notas de entrega" />
                    </div>
                </div>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-dismiss="modal" onclick="alert('Orden de compra emitida.')">Emitir Orden</button>
            </div>
        </div>
    </div>
</div>
