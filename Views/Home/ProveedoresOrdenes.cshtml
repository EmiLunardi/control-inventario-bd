<!-- Modal Nuevo Proveedor -->
<div class="modal fade" id="modalNuevoProveedor" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">Dar de Alta Proveedor</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label">Razón Social</label>
                    <input type="text" class="form-control" placeholder="Ej: Distribuidora Mayorista S.A." />
                </div>
                <div class="mb-3">
                    <label class="form-label">CUIT</label>
                    <input type="text" class="form-control" placeholder="30-XXXXXXXX-X" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Teléfono</label>
                    <input type="text" class="form-control" placeholder="011-XXXX-XXXX" />
                </div>
                <div class="mb-3">
                    <label class="form-label">Email</label>
                    <input type="email" class="form-control" placeholder="ventas@proveedor.com.ar" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-dark" data-bs-dismiss="modal" onclick="alert('Proveedor registrado en el catálogo.')">Guardar Proveedor</button>
            </div>
        </div>
    </div>
</div>

<!-- Modal Nueva Orden de Compra -->
<div class="modal fade" id="modalNuevaOrden" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title">Emitir Orden de Compra de Reposición</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="row g-3">
                    <div class="col-md-6">
                        <label class="form-label">Proveedor</label>
                        <select class="form-select">
                            <option>Distribuidora Quilmes S.A.</option>
                            <option>Molinos del Sur S.R.L.</option>
                            <option>Lácteos La Serenísima S.A.</option>
                            <option>Química Limpia S.A.</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Sucursal de Destino</label>
                        <select class="form-select">
                            <option>Central</option>
                            <option>Sucursal Norte</option>
                            <option>Sucursal Sur</option>
                        </select>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">Producto a Reponer</label>
                        <select class="form-select">
                            <option>SKU-BEB-002 - Cerveza Lager 1L (Crítico)</option>
                            <option>SKU-LAC-001 - Leche Entera 1L (Crítico)</option>
                            <option>SKU-ALM-002 - Fideos Espagueti 500g (Advertencia)</option>
                        </select>
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Cantidad Solicitada</label>
                        <input type="number" class="form-control" value="100" />
                    </div>
                    <div class="col-md-3">
                        <label class="form-label">Costo Unitario ($)</label>
                        <input type="number" class="form-control" value="1650.00" />
                    </div>
                    <div class="col-12">
                        <label class="form-label">Observaciones</label>
                        <input type="text" class="form-control" placeholder="Reposición urgente por quiebre de stock mínimo" />
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-success" data-bs-dismiss="modal" onclick="alert('Orden de Compra emitida correctamente.')">Emitir Orden</button>
            </div>
        </div>
    </div>
</div>
