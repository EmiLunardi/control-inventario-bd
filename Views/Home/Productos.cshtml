@model IEnumerable<ControlInventario.Models.Producto>
@{
    ViewData["Title"] = "Catálogo de Productos";
}

<div class="container-fluid">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Catálogo de Productos</h2>
            <p class="text-muted mb-0">Administración de artículos, costos, precios y control de existencias</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#modalNuevoProducto">
            + Nuevo Producto
        </button>
    </div>

    <!-- Barra de Filtros y Búsqueda -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold text-secondary small">Buscar por SKU o Nombre</label>
                    <input type="text" id="txtBuscarProducto" class="form-control" placeholder="Buscar artículo..." onkeyup="filtrarTablaProductos()" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary small">Categoría</label>
                    <select id="cmbCategoria" class="form-select" onchange="filtrarTablaProductos()">
                        <option value="">Todas las categorías</option>
                        <option value="Bebidas">Bebidas</option>
                        <option value="Almacén">Almacén</option>
                        <option value="Lácteos">Lácteos</option>
                        <option value="Limpieza">Limpieza</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary small">Proveedor</label>
                    <select id="cmbProveedor" class="form-select" onchange="filtrarTablaProductos()">
                        <option value="">Todos los proveedores</option>
                        <option value="Distribuidora Quilmes S.A.">Distribuidora Quilmes S.A.</option>
                        <option value="Molinos del Sur S.R.L.">Molinos del Sur S.R.L.</option>
                        <option value="Lácteos La Serenísima S.A.">Lácteos La Serenísima S.A.</option>
                        <option value="Química Limpia S.A.">Química Limpia S.A.</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100" onclick="limpiarFiltrosProductos()">Limpiar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla Principal de Productos -->
    <div class="card">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-dark">Listado de Artículos</h5>
            <span class="badge bg-light text-secondary border">@Model.Count() productos registrados</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tablaProductos">
                    <thead>
                        <tr>
                            <th>SKU</th>
                            <th>Producto</th>
                            <th>Categoría</th>
                            <th>Proveedor</th>
                            <th>Costo</th>
                            <th>Precio Venta</th>
                            <th>Stock Actual</th>
                            <th>Stock Mínimo</th>
                            <th>Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td><code>@item.CodigoSku</code></td>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td>@item.CategoriaNombre</td>
                                <td>@item.ProveedorNombre</td>
                                <td>$@item.PrecioCosto.ToString("N2")</td>
                                <td class="fw-semibold">$@item.Precio.ToString("N2")</td>
                                <td class="fw-bold">@item.StockActual u.</td>
                                <td>@item.StockMinimo u.</td>
                                <td>
                                    <span class="badge @item.ObtenerClaseBadge()">@item.ObtenerEstadoSemaforo()</span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1" onclick="alert('Editar producto: @item.Nombre')">Editar</button>
                                    <button class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="alert('Dar de baja: @item.CodigoSku')">Baja</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Alta de Producto -->
<div class="modal fade" id="modalNuevoProducto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">Registrar Nuevo Producto</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body p-4">
                <form id="formNuevoProducto">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Código SKU</label>
                            <input type="text" class="form-control" placeholder="SKU-XXX-000" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Nombre del Producto</label>
                            <input type="text" class="form-control" placeholder="Ej: Aceite de Girasol 1.5L" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Categoría</label>
                            <select class="form-select">
                                <option>Bebidas</option>
                                <option>Almacén</option>
                                <option>Lácteos</option>
                                <option>Limpieza</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Proveedor Habitual</label>
                            <select class="form-select">
                                <option>Distribuidora Quilmes S.A.</option>
                                <option>Molinos del Sur S.R.L.</option>
                                <option>Lácteos La Serenísima S.A.</option>
                                <option>Química Limpia S.A.</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Precio Costo ($)</label>
                            <input type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Precio Venta ($)</label>
                            <input type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Stock Inicial</label>
                            <input type="number" class="form-control" value="50" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Stock Mínimo</label>
                            <input type="number" class="form-control" value="20" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer bg-light">
                <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary rounded-pill px-4" data-bs-dismiss="modal" onclick="alert('Producto guardado correctamente.')">Guardar Producto</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filtrarTablaProductos() {
            const texto = document.getElementById('txtBuscarProducto').value.toLowerCase();
            const categoria = document.getElementById('cmbCategoria').value.toLowerCase();
            const proveedor = document.getElementById('cmbProveedor').value.toLowerCase();
            const filas = document.querySelectorAll('#tablaProductos tbody tr');

            filas.forEach(fila => {
                const colSku = fila.cells[0].innerText.toLowerCase();
                const colNombre = fila.cells[1].innerText.toLowerCase();
                const colCat = fila.cells[2].innerText.toLowerCase();
                const colProv = fila.cells[3].innerText.toLowerCase();

                const coincideTexto = colSku.includes(texto) || colNombre.includes(texto);
                const coincideCat = categoria === '' || colCat === categoria;
                const coincideProv = proveedor === '' || colProv === proveedor;

                fila.style.display = (coincideTexto && coincideCat && coincideProv) ? '' : 'none';
            });
        }

        function limpiarFiltrosProductos() {
            document.getElementById('txtBuscarProducto').value = '';
            document.getElementById('cmbCategoria').value = '';
            document.getElementById('cmbProveedor').value = '';
            filtrarTablaProductos();
        }
    </script>
}
