@{
    ViewData["Title"] = "Gestión de Productos";
}

<div class="container-fluid mt-3">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2 class="mb-0">Gestión de Catálogo de Productos</h2>
            <small class="text-muted">Administración de artículos, costos, precios de venta, proveedores y stock por sucursal</small>
        </div>
        <button class="btn btn-primary" data-bs-toggle="modal" data-bs-target="#modalNuevoProducto">
            + Nuevo Producto
        </button>
    </div>

    <!-- Barra de Filtros y Búsqueda -->
    <div class="card shadow-sm mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">Buscar por SKU o Nombre</label>
                    <input type="text" id="txtBuscarProducto" class="form-control" placeholder="Ej: SKU-001, Agua Mineral, Arroz..." onkeyup="filtrarTablaProductos()" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Categoría</label>
                    <select id="cmbCategoria" class="form-select" onchange="filtrarTablaProductos()">
                        <option value="">Todas las categorías</option>
                        <option value="Bebidas">Bebidas</option>
                        <option value="Almacén">Almacén</option>
                        <option value="Lácteos">Lácteos</option>
                        <option value="Limpieza">Limpieza</option>
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold">Proveedor Principal</label>
                    <select id="cmbProveedor" class="form-select" onchange="filtrarTablaProductos()">
                        <option value="">Todos los proveedores</option>
                        <option value="Distribuidora Quilmes S.A.">Distribuidora Quilmes S.A.</option>
                        <option value="Molinos del Sur S.R.L.">Molinos del Sur S.R.L.</option>
                        <option value="Lácteos La Serenísima S.A.">Lácteos La Serenísima S.A.</option>
                        <option value="Química Limpia S.A.">Química Limpia S.A.</option>
                    </select>
                </div>
                <div class="col-md-2">
                    <button class="btn btn-outline-secondary w-100" onclick="limpiarFiltrosProductos()">Limpiar Filtros</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla Principal de Productos -->
    <div class="card shadow-sm">
        <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Listado Maestro de Productos</h5>
            <span class="badge bg-light text-dark">6 Artículos Activos</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover table-striped align-middle mb-0" id="tablaProductos">
                    <thead class="table-secondary">
                        <tr>
                            <th>SKU</th>
                            <th>Producto</th>
                            <th>Categoría</th>
                            <th>Proveedor</th>
                            <th>Costo</th>
                            <th>Precio Venta</th>
                            <th>Stock Global</th>
                            <th>Punto Reorden</th>
                            <th>Estado</th>
                            <th class="text-center">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><code>SKU-BEB-001</code></td>
                            <td class="fw-semibold">Agua Mineral 1.5L</td>
                            <td>Bebidas</td>
                            <td>Distribuidora Quilmes S.A.</td>
                            <td>$520.00</td>
                            <td>$800.00</td>
                            <td>150 u.</td>
                            <td>50 u.</td>
                            <td><span class="badge bg-success">Óptimo</span></td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary me-1" onclick="alert('Edición de producto: Agua Mineral 1.5L')">Editar</button>
                                <button class="btn btn-sm btn-outline-danger" onclick="alert('Baja lógica de producto SKU-BEB-001')">Baja</button>
                            </td>
                        </tr>
                        <tr>
                            <td><code>SKU-BEB-002</code></td>
                            <td class="fw-semibold">Cerveza Lager 1L</td>
                            <td>Bebidas</td>
                            <td>Distribuidora Quilmes S.A.</td>
                            <td>$1,650.00</td>
                            <td>$2,500.00</td>
                            <td>30 u.</td>
                            <td>100 u.</td>
                            <td><span class="badge bg-danger">Crítico</span></td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary me-1" onclick="alert('Edición de producto: Cerveza Lager 1L')">Editar</button>
                                <button class="btn btn-sm btn-outline-danger" onclick="alert('Baja lógica de producto SKU-BEB-002')">Baja</button>
                            </td>
                        </tr>
                        <tr>
                            <td><code>SKU-ALM-001</code></td>
                            <td class="fw-semibold">Arroz Blanco 1kg</td>
                            <td>Almacén</td>
                            <td>Molinos del Sur S.R.L.</td>
                            <td>$780.00</td>
                            <td>$1,200.00</td>
                            <td>200 u.</td>
                            <td>30 u.</td>
                            <td><span class="badge bg-success">Óptimo</span></td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary me-1" onclick="alert('Edición de producto: Arroz Blanco 1kg')">Editar</button>
                                <button class="btn btn-sm btn-outline-danger" onclick="alert('Baja lógica de producto SKU-ALM-001')">Baja</button>
                            </td>
                        </tr>
                        <tr>
                            <td><code>SKU-ALM-002</code></td>
                            <td class="fw-semibold">Fideos Espagueti 500g</td>
                            <td>Almacén</td>
                            <td>Molinos del Sur S.R.L.</td>
                            <td>$580.00</td>
                            <td>$900.00</td>
                            <td>45 u.</td>
                            <td>40 u.</td>
                            <td><span class="badge bg-warning text-dark">Advertencia</span></td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary me-1" onclick="alert('Edición de producto: Fideos Espagueti 500g')">Editar</button>
                                <button class="btn btn-sm btn-outline-danger" onclick="alert('Baja lógica de producto SKU-ALM-002')">Baja</button>
                            </td>
                        </tr>
                        <tr>
                            <td><code>SKU-LAC-001</code></td>
                            <td class="fw-semibold">Leche Entera 1L</td>
                            <td>Lácteos</td>
                            <td>Lácteos La Serenísima S.A.</td>
                            <td>$720.00</td>
                            <td>$1,100.00</td>
                            <td>15 u.</td>
                            <td>50 u.</td>
                            <td><span class="badge bg-danger">Crítico</span></td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary me-1" onclick="alert('Edición de producto: Leche Entera 1L')">Editar</button>
                                <button class="btn btn-sm btn-outline-danger" onclick="alert('Baja lógica de producto SKU-LAC-001')">Baja</button>
                            </td>
                        </tr>
                        <tr>
                            <td><code>SKU-LIM-001</code></td>
                            <td class="fw-semibold">Lavandina Concentrada 1L</td>
                            <td>Limpieza</td>
                            <td>Química Limpia S.A.</td>
                            <td>$490.00</td>
                            <td>$850.00</td>
                            <td>120 u.</td>
                            <td>20 u.</td>
                            <td><span class="badge bg-success">Óptimo</span></td>
                            <td class="text-center">
                                <button class="btn btn-sm btn-outline-primary me-1" onclick="alert('Edición de producto: Lavandina Concentrada 1L')">Editar</button>
                                <button class="btn btn-sm btn-outline-danger" onclick="alert('Baja lógica de producto SKU-LIM-001')">Baja</button>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Alta de Producto -->
<div class="modal fade" id="modalNuevoProducto" tabindex="-1" aria-labelledby="modalNuevoProductoLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title" id="modalNuevoProductoLabel">Registrar Nuevo Producto</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
            </div>
            <div class="modal-body">
                <form id="formNuevoProducto">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label">Código SKU</label>
                            <input type="text" class="form-control" placeholder="SKU-XXX-000" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label">Nombre del Producto</label>
                            <input type="text" class="form-control" placeholder="Ej: Aceite de Girasol 1.5L" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Categoría</label>
                            <select class="form-select">
                                <option>Bebidas</option>
                                <option>Almacén</option>
                                <option>Lácteos</option>
                                <option>Limpieza</option>
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label">Proveedor Habitual</label>
                            <select class="form-select">
                                <option>Distribuidora Quilmes S.A.</option>
                                <option>Molinos del Sur S.R.L.</option>
                                <option>Lácteos La Serenísima S.A.</option>
                                <option>Química Limpia S.A.</option>
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Precio Costo ($)</label>
                            <input type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Precio Venta ($)</label>
                            <input type="number" step="0.01" class="form-control" placeholder="0.00" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Stock Inicial</label>
                            <input type="number" class="form-control" value="0" />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Stock Mínimo (Alerta)</label>
                            <input type="number" class="form-control" value="20" />
                        </div>
                    </div>
                </form>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                <button type="button" class="btn btn-primary" data-bs-dismiss="modal" onclick="alert('Producto guardado correctamente (Prototipo UI)')">Guardar Producto</button>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filtrarTablaProductos() {
            const texto = document.getElementById('txtBuscarProducto').value.toLowerCase();
            const categoria = document.getElementById('cmbCategoria').value.toLowerCase();
            const proveedor = document.getElementById('cmbProveedor').value.toLowerCase();
            const filas = document.querySelectorAll('#tablaProductos tbody tr');

            filas.forEach(fila => {
                const colSku = fila.cells[0].innerText.toLowerCase();
                const colNombre = fila.cells[1].innerText.toLowerCase();
                const colCat = fila.cells[2].innerText.toLowerCase();
                const colProv = fila.cells[3].innerText.toLowerCase();

                const coincideTexto = colSku.includes(texto) || colNombre.includes(texto);
                const coincideCat = categoria === '' || colCat === categoria;
                const coincideProv = proveedor === '' || colProv === proveedor;

                fila.style.display = (coincideTexto && coincideCat && coincideProv) ? '' : 'none';
            });
        }

        function limpiarFiltrosProductos() {
            document.getElementById('txtBuscarProducto').value = '';
            document.getElementById('cmbCategoria').value = '';
            document.getElementById('cmbProveedor').value = '';
            filtrarTablaProductos();
        }
    </script>
}
