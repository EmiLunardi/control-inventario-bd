@model ControlInventario.Models.DashboardViewModel
@{
    ViewData["Title"] = "Catálogo de Productos";
}

<div class="container-fluid">
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4 gap-2">
        <div>
            <h2 class="fw-bold mb-1">Catálogo de Productos</h2>
            <p class="text-muted mb-0">Administración de artículos, costos, precios y control de existencias</p>
        </div>
        <button class="btn btn-primary rounded-pill px-4" data-bs-toggle="modal" data-bs-target="#modalNuevoProducto">
            + Nuevo Producto
        </button>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <strong>✔ Operación exitosa:</strong> @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <!-- Barra de Filtros y Búsqueda -->
    <div class="card mb-4">
        <div class="card-body">
            <div class="row g-3 align-items-end">
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary small">Buscar por SKU o Nombre</label>
                    <input type="text" id="txtBuscarProducto" class="form-control" placeholder="Buscar artículo..." onkeyup="filtrarTablaProductos()" />
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary small">Categoría</label>
                    <select id="cmbCategoria" class="form-select" onchange="filtrarTablaProductos()">
                        <option value="">Todas las categorías</option>
                        @foreach (var cat in Model.CategoriasResumen)
                        {
                            <option value="@cat.Nombre">@cat.Nombre</option>
                        }
                    </select>
                </div>
                <div class="col-md-3">
                    <label class="form-label fw-semibold text-secondary small">Proveedor</label>
                    <select id="cmbProveedor" class="form-select" onchange="filtrarTablaProductos()">
                        <option value="">Todos los proveedores</option>
                        @foreach (var prov in Model.Proveedores)
                        {
                            <option value="@prov.RazonSocial">@prov.RazonSocial</option>
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label fw-semibold text-secondary small">Estado</label>
                    <select id="cmbSemaforo" class="form-select" onchange="filtrarTablaProductos()">
                        <option value="">Todos</option>
                        <option value="Óptimo">Óptimo</option>
                        <option value="Advertencia">Advertencia</option>
                        <option value="Crítico">Crítico</option>
                    </select>
                </div>
                <div class="col-md-1">
                    <button class="btn btn-outline-secondary w-100" onclick="limpiarFiltrosProductos()">Limpiar</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Tabla Principal de Productos -->
    <div class="card">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-dark">Listado de Artículos</h5>
            <span class="badge bg-light text-secondary border">@Model.Productos.Count productos registrados</span>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0" id="tablaProductos">
                    <thead>
                        <tr>
                            <th>SKU</th>
                            <th>Producto</th>
                            <th>Categoría</th>
                            <th>Proveedor</th>
                            <th>Costo</th>
                            <th>Precio Venta</th>
                            <th class="text-center">Stock Actual</th>
                            <th class="text-center">Stock Mínimo</th>
                            <th class="text-center">Estado</th>
                            <th class="text-end">Acciones</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model.Productos)
                        {
                            <tr>
                                <td><code>@item.CodigoSku</code></td>
                                <td class="fw-semibold">@item.Nombre</td>
                                <td>@item.CategoriaNombre</td>
                                <td>@item.ProveedorNombre</td>
                                <td>$@item.PrecioCosto.ToString("N2")</td>
                                <td class="fw-semibold">$@item.Precio.ToString("N2")</td>
                                <td class="text-center fw-bold">@item.StockActual u.</td>
                                <td class="text-center">@item.StockMinimo u.</td>
                                <td class="text-center">
                                    <span class="badge @item.ObtenerClaseBadge()">@item.ObtenerEstadoSemaforo()</span>
                                </td>
                                <td class="text-end text-nowrap">
                                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 me-1"
                                            onclick="abrirModalEditar(@item.Id, '@item.Nombre', @item.StockActual, @item.StockMinimo, @item.Precio.ToString(System.Globalization.CultureInfo.InvariantCulture))">
                                        Ajustar
                                    </button>
                                    <form asp-action="EliminarProducto" method="post" class="d-inline" onsubmit="return confirm('¿Dar de baja el producto @item.Nombre?');">
                                        <input type="hidden" name="id" value="@item.Id" />
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3">Baja</button>
                                    </form>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

<!-- Modal Alta de Producto -->
<div class="modal fade" id="modalNuevoProducto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-lg">
        <div class="modal-content border-0 shadow">
            <form asp-action="CrearProducto" method="post">
                <div class="modal-header bg-dark text-white">
                    <h5 class="modal-title">Registrar Nuevo Producto</h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Cerrar"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="row g-3">
                        <div class="col-md-4">
                            <label class="form-label fw-semibold">Código SKU</label>
                            <input type="text" name="codigoSku" class="form-control" placeholder="SKU-XXX-000" required />
                        </div>
                        <div class="col-md-8">
                            <label class="form-label fw-semibold">Nombre del Producto</label>
                            <input type="text" name="nombre" class="form-control" placeholder="Ej: Yerba Mate Selección 1kg" required />
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Categoría</label>
                            <select name="categoriaId" class="form-select">
                                @foreach (var cat in Model.CategoriasResumen)
                                {
                                    <option value="@cat.CategoriaId">@cat.Nombre</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-6">
                            <label class="form-label fw-semibold">Proveedor Habitual</label>
                            <select name="proveedorId" class="form-select">
                                @foreach (var prov in Model.Proveedores)
                                {
                                    <option value="@prov.Id">@prov.RazonSocial</option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Precio Costo ($)</label>
                            <input type="number" step="0.01" name="precioCosto" class="form-control" value="800" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Precio Venta ($)</label>
                            <input type="number" step="0.01" name="precio" class="form-control" value="1250" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Stock Inicial</label>
                            <input type="number" name="stockInicial" class="form-control" value="50" required />
                        </div>
                        <div class="col-md-3">
                            <label class="form-label fw-semibold">Stock Mínimo</label>
                            <input type="number" name="stockMinimo" class="form-control" value="20" required />
                        </div>
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Guardar Producto</button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal Editar Stock / Umbral del Producto -->
<div class="modal fade" id="modalEditarProducto" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content border-0 shadow">
            <form asp-action="ActualizarStockProducto" method="post">
                <input type="hidden" name="id" id="editProdId" />
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title">Ajustar Parámetros — <span id="editProdNombre"></span></h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Stock Actual Consolidado (u.)</label>
                        <input type="number" name="stockActual" id="editProdStockActual" class="form-control" required />
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Umbral de Stock Mínimo (u.)</label>
                        <input type="number" name="stockMinimo" id="editProdStockMinimo" class="form-control" required />
                        <small class="text-muted">El semáforo pasará a Advertencia si el stock está dentro del +10% de este valor, o Crítico si es menor o igual.</small>
                    </div>
                    <div class="mb-2">
                        <label class="form-label fw-semibold">Precio de Venta ($)</label>
                        <input type="number" step="0.01" name="precio" id="editProdPrecio" class="form-control" required />
                    </div>
                </div>
                <div class="modal-footer bg-light">
                    <button type="button" class="btn btn-outline-secondary rounded-pill px-4" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-primary rounded-pill px-4">Actualizar y Recalcular Semáforo</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filtrarTablaProductos() {
            const texto = document.getElementById('txtBuscarProducto').value.toLowerCase();
            const categoria = document.getElementById('cmbCategoria').value.toLowerCase();
            const proveedor = document.getElementById('cmbProveedor').value.toLowerCase();
            const semaforo = document.getElementById('cmbSemaforo').value.toLowerCase();
            const filas = document.querySelectorAll('#tablaProductos tbody tr');

            filas.forEach(fila => {
                const colSku = fila.cells[0].innerText.toLowerCase();
                const colNombre = fila.cells[1].innerText.toLowerCase();
                const colCat = fila.cells[2].innerText.toLowerCase();
                const colProv = fila.cells[3].innerText.toLowerCase();
                const colEstado = fila.cells[8].innerText.trim().toLowerCase();

                const coincideTexto = colSku.includes(texto) || colNombre.includes(texto);
                const coincideCat = categoria === '' || colCat === categoria;
                const coincideProv = proveedor === '' || colProv === proveedor;
                const coincideSem = semaforo === '' || colEstado === semaforo;

                fila.style.display = (coincideTexto && coincideCat && coincideProv && coincideSem) ? '' : 'none';
            });
        }

        function limpiarFiltrosProductos() {
            document.getElementById('txtBuscarProducto').value = '';
            document.getElementById('cmbCategoria').value = '';
            document.getElementById('cmbProveedor').value = '';
            document.getElementById('cmbSemaforo').value = '';
            filtrarTablaProductos();
        }

        function abrirModalEditar(id, nombre, stockActual, stockMinimo, precio) {
            document.getElementById('editProdId').value = id;
            document.getElementById('editProdNombre').innerText = nombre;
            document.getElementById('editProdStockActual').value = stockActual;
            document.getElementById('editProdStockMinimo').value = stockMinimo;
            document.getElementById('editProdPrecio').value = precio;
            const modal = new bootstrap.Modal(document.getElementById('modalEditarProducto'));
            modal.show();
        }
    </script>
}
