@model IEnumerable<ControlInventario.Models.Producto>
@{
    ViewData["Title"] = "Tablero de Control";
}

<div class="container-fluid">
    <!-- Encabezado -->
    <div class="d-flex flex-wrap justify-content-between align-items-center mb-4">
        <div>
            <h2 class="fw-bold mb-1">Tablero de Control</h2>
            <p class="text-muted mb-0">Monitoreo en tiempo real del estado del inventario y movimientos logísticos</p>
        </div>
    </div>

    <!-- Resumen General (Semaforización) -->
    <div class="card mb-4">
        <div class="card-header bg-white">
            <h5 class="mb-0 text-dark">Estado General del Stock</h5>
        </div>
        <div class="card-body">
            <div class="row g-3 text-center mb-4">
                <div class="col-md-3">
                    <div class="card kpi-card kpi-optimo h-100">
                        <div class="card-body py-4">
                            <h6 class="text-uppercase opacity-75 mb-2">Stock Óptimo</h6>
                            <p class="display-5 fw-bold mb-1">45</p>
                            <small class="opacity-90">Abastecimiento normal</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card kpi-card kpi-advertencia h-100">
                        <div class="card-body py-4">
                            <h6 class="text-uppercase opacity-75 mb-2">Stock en Advertencia</h6>
                            <p class="display-5 fw-bold mb-1">12</p>
                            <small class="opacity-90">Próximos al límite de reposición</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card kpi-card kpi-critico h-100">
                        <div class="card-body py-4">
                            <h6 class="text-uppercase opacity-75 mb-2">Stock Crítico</h6>
                            <p class="display-5 fw-bold mb-1">5</p>
                            <small class="opacity-90">Requieren reposición inmediata</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card kpi-card kpi-info h-100">
                        <div class="card-body py-4">
                            <h6 class="text-uppercase opacity-75 mb-2">Total Movimientos</h6>
                            <p class="display-5 fw-bold mb-1">128</p>
                            <small class="opacity-90">Registrados en los últimos 30 días</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Listado de Categorías -->
            <h6 class="fw-semibold text-secondary mb-3">Seleccione una categoría para explorar sus productos</h6>
            <div class="list-group rounded-3">
                <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" onclick="mostrarNivel2('Bebidas')">
                    <span>Bebidas</span>
                    <span class="badge bg-primary rounded-pill">14 Productos</span>
                </a>
                <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" onclick="mostrarNivel2('Almacén')">
                    <span>Almacén</span>
                    <span class="badge bg-primary rounded-pill">25 Productos</span>
                </a>
                <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" onclick="mostrarNivel2('Lácteos')">
                    <span>Lácteos</span>
                    <span class="badge bg-primary rounded-pill">15 Productos</span>
                </a>
                <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" onclick="mostrarNivel2('Limpieza')">
                    <span>Limpieza</span>
                    <span class="badge bg-primary rounded-pill">8 Productos</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Detalle por Categoría (Productos) -->
    <div id="nivel2" class="card mb-4" style="display: none;">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-dark">Productos en Categoría <span id="lblCategoria" class="text-primary"></span></h5>
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="ocultarNivel2()">Volver a Categorías</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Código SKU</th>
                            <th>Producto</th>
                            <th>Precio</th>
                            <th>Stock Actual</th>
                            <th>Stock Mínimo</th>
                            <th>Estado</th>
                            <th class="text-end">Acción</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var prod in Model.Take(3))
                        {
                            <tr>
                                <td><code>@prod.CodigoSku</code></td>
                                <td class="fw-semibold">@prod.Nombre</td>
                                <td>$@prod.Precio.ToString("N2")</td>
                                <td class="fw-bold">@prod.StockActual u.</td>
                                <td>@prod.StockMinimo u.</td>
                                <td>
                                    <span class="badge @prod.ObtenerClaseBadge()">@prod.ObtenerEstadoSemaforo()</span>
                                </td>
                                <td class="text-end">
                                    <button class="btn btn-sm btn-outline-primary rounded-pill px-3" onclick="mostrarNivel3('@prod.Nombre')">Ver Movimientos</button>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>

    <!-- Detalle de Movimientos del Producto -->
    <div id="nivel3" class="card" style="display: none;">
        <div class="card-header bg-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0 text-dark">Historial de Movimientos — <span id="lblProducto" class="text-primary"></span></h5>
            <button class="btn btn-sm btn-outline-secondary rounded-pill px-3" onclick="ocultarNivel3()">Volver a Productos</button>
        </div>
        <div class="card-body p-0">
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Fecha</th>
                            <th>Sucursal</th>
                            <th>Responsable</th>
                            <th>Tipo de Movimiento</th>
                            <th>Cantidad</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td>2026-10-25 10:30</td>
                            <td>Central</td>
                            <td><code>admin</code></td>
                            <td><span class="badge bg-success">ENTRADA</span></td>
                            <td class="fw-bold text-success">+ 100 u.</td>
                        </tr>
                        <tr>
                            <td>2026-10-26 15:45</td>
                            <td>Sucursal Norte</td>
                            <td><code>gerente_log</code></td>
                            <td><span class="badge bg-danger">SALIDA</span></td>
                            <td class="fw-bold text-danger">- 20 u.</td>
                        </tr>
                        <tr>
                            <td>2026-10-27 09:15</td>
                            <td>Sucursal Sur</td>
                            <td><code>operador_sur</code></td>
                            <td><span class="badge bg-danger">SALIDA</span></td>
                            <td class="fw-bold text-danger">- 15 u.</td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function mostrarNivel2(categoria) {
            document.getElementById('lblCategoria').innerText = categoria;
            document.getElementById('nivel2').style.display = 'block';
            document.getElementById('nivel3').style.display = 'none';
            document.getElementById('nivel2').scrollIntoView({ behavior: 'smooth' });
        }

        function ocultarNivel2() {
            document.getElementById('nivel2').style.display = 'none';
            document.getElementById('nivel3').style.display = 'none';
        }

        function mostrarNivel3(producto) {
            document.getElementById('lblProducto').innerText = producto;
            document.getElementById('nivel3').style.display = 'block';
            document.getElementById('nivel3').scrollIntoView({ behavior: 'smooth' });
        }

        function ocultarNivel3() {
            document.getElementById('nivel3').style.display = 'none';
        }
    </script>
}
