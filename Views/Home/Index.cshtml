@{
    ViewData["Title"] = "Tablero de Control - Inventario";
}

<div class="container-fluid mt-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Dashboard - Distribuidora</h2>
        <div>
            <span class="me-3">Bienvenido, <strong>@User.Identity?.Name</strong></span>
            <a asp-controller="Account" asp-action="Logout" class="btn btn-outline-danger btn-sm">Cerrar Sesión</a>
        </div>
    </div>

    <!-- Nivel 1: Resumen General (Semaforización) -->
    <div class="card mb-4 shadow-sm">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">Estado General del Stock por Categorías</h5>
        </div>
        <div class="card-body">
            <div class="row text-center">
                <div class="col-md-3">
                    <div class="card text-white bg-success mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Stock Óptimo</h5>
                            <p class="card-text display-6">45</p>
                            <small>Productos por encima del nivel mínimo</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-dark bg-warning mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Stock de Advertencia</h5>
                            <p class="card-text display-6">12</p>
                            <small>Productos cerca del nivel mínimo</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                    <div class="card text-white bg-danger mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Stock Crítico</h5>
                            <p class="card-text display-6">5</p>
                            <small>Productos por debajo del nivel mínimo</small>
                        </div>
                    </div>
                </div>
                <div class="col-md-3">
                     <div class="card text-white bg-info mb-3">
                        <div class="card-body">
                            <h5 class="card-title">Total Movimientos</h5>
                            <p class="card-text display-6">128</p>
                            <small>En los últimos 30 días</small>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Listado de Categorías para Navegar al Nivel 2 -->
            <h6 class="mt-3">Seleccione una Categoría para ver el detalle de sus productos</h6>
            <div class="list-group">
                <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" onclick="mostrarNivel2('Bebidas')">
                    Bebidas
                    <span class="badge bg-primary rounded-pill">14 Productos</span>
                </a>
                <a href="#" class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" onclick="mostrarNivel2('Almacén')">
                    Almacén
                    <span class="badge bg-primary rounded-pill">25 Productos</span>
                </a>
            </div>
        </div>
    </div>

    <!-- Nivel 2: Detalle por Categoría (Productos) -->
    <div id="nivel2" class="card mb-4 shadow-sm" style="display: none;">
        <div class="card-header bg-secondary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Productos en Categoría <span id="lblCategoria"></span></h5>
            <button class="btn btn-sm btn-light" onclick="ocultarNivel2()">Volver a Categorías</button>
        </div>
        <div class="card-body">
            <table class="table table-hover table-bordered">
                <thead class="table-light">
                    <tr>
                        <th>ID</th>
                        <th>Producto</th>
                        <th>Precio</th>
                        <th>Stock Actual</th>
                        <th>Stock Mínimo</th>
                        <th>Estado</th>
                        <th>Acción</th>
                    </tr>
                </thead>
                <tbody>
                    <!-- Datos estáticos para maqueta UI -->
                    <tr>
                        <td>1</td>
                        <td>Agua Mineral 1.5L</td>
                        <td>$800.00</td>
                        <td>150</td>
                        <td>50</td>
                        <td><span class="badge bg-success">Óptimo</span></td>
                        <td><button class="btn btn-sm btn-outline-primary" onclick="mostrarNivel3('Agua Mineral 1.5L')">Ver Movimientos</button></td>
                    </tr>
                    <tr>
                        <td>2</td>
                        <td>Cerveza Lager 1L</td>
                        <td>$2500.00</td>
                        <td>105</td>
                        <td>100</td>
                        <td><span class="badge bg-warning text-dark">Advertencia</span></td>
                        <td><button class="btn btn-sm btn-outline-primary" onclick="mostrarNivel3('Cerveza Lager 1L')">Ver Movimientos</button></td>
                    </tr>
                    <tr>
                        <td>5</td>
                        <td>Leche Entera 1L</td>
                        <td>$1100.00</td>
                        <td>15</td>
                        <td>50</td>
                        <td><span class="badge bg-danger">Crítico</span></td>
                        <td><button class="btn btn-sm btn-outline-primary" onclick="mostrarNivel3('Leche Entera 1L')">Ver Movimientos</button></td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>

    <!-- Nivel 3: Detalle de Movimientos del Producto -->
    <div id="nivel3" class="card shadow-sm" style="display: none;">
        <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
            <h5 class="mb-0">Detalle de Movimientos - <span id="lblProducto"></span></h5>
            <button class="btn btn-sm btn-light" onclick="ocultarNivel3()">Volver a Productos</button>
        </div>
        <div class="card-body">
            <table class="table table-striped table-bordered">
                <thead>
                    <tr>
                        <th>Fecha</th>
                        <th>Sucursal</th>
                        <th>Tipo Movimiento</th>
                        <th>Cantidad</th>
                    </tr>
                </thead>
                <tbody>
                    <tr>
                        <td>2023-10-25 10:30</td>
                        <td>Central</td>
                        <td><span class="text-success fw-bold">ENTRADA</span></td>
                        <td>+ 100</td>
                    </tr>
                    <tr>
                        <td>2023-10-26 15:45</td>
                        <td>Sucursal Norte</td>
                        <td><span class="text-danger fw-bold">SALIDA</span></td>
                        <td>- 20</td>
                    </tr>
                    <tr>
                        <td>2023-10-27 09:15</td>
                        <td>Sucursal Sur</td>
                        <td><span class="text-danger fw-bold">SALIDA</span></td>
                        <td>- 15</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        // Lógica simple de frontend para simular el Drill-Down / Drill-Up para la Primera Entrega
        function mostrarNivel2(categoria) {
            document.getElementById('lblCategoria').innerText = "'" + categoria + "'";
            document.getElementById('nivel2').style.display = 'block';
            document.getElementById('nivel3').style.display = 'none'; // Ocultar nivel 3 si estaba abierto
            // Scroll hacia la seccion
            document.getElementById('nivel2').scrollIntoView({ behavior: 'smooth' });
        }

        function ocultarNivel2() {
            document.getElementById('nivel2').style.display = 'none';
            document.getElementById('nivel3').style.display = 'none';
        }

        function mostrarNivel3(producto) {
            document.getElementById('lblProducto').innerText = producto;
            document.getElementById('nivel3').style.display = 'block';
            document.getElementById('nivel3').scrollIntoView({ behavior: 'smooth' });
        }

        function ocultarNivel3() {
            document.getElementById('nivel3').style.display = 'none';
        }
    </script>
}
