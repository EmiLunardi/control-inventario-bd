@model ControlInventario.Models.DashboardViewModel
@{
    ViewData["Title"] = "Movimientos de Stock";
}

<div class="container-fluid">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Movimientos de Stock y Auditoría por Sucursal</h2>
        <p class="text-muted mb-0">Registro transaccional de ingresos, despachos y ajustes con impacto en tiempo real sobre el semáforo de stock</p>
    </div>

    @if (TempData["Mensaje"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show shadow-sm border-0 mb-4" role="alert">
            <strong>✔ Movimiento asentado:</strong> @TempData["Mensaje"]
            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Cerrar"></button>
        </div>
    }

    <div class="row g-4">
        <!-- Columna Izquierda: Formulario de Nuevo Movimiento -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-white">
                    <h5 class="mb-0 text-dark">Registrar Operación</h5>
                </div>
                <div class="card-body">
                    <form asp-action="RegistrarMovimiento" method="post">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Tipo de Operación</label>
                            <select name="tipoMovimiento" class="form-select" required>
                                <option value="ENTRADA">Entrada de Mercadería (+)</option>
                                <option value="SALIDA">Salida / Despacho (-)</option>
                                <option value="AJUSTE">Ajuste Positivo de Inventario (+)</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Sucursal</label>
                            <select name="sucursalId" class="form-select" required>
                                @foreach (var suc in Model.Sucursales)
                                {
                                    <option value="@suc.Id">@suc.Nombre — @suc.Ubicacion</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Producto</label>
                            <select name="productoId" class="form-select" required>
                                @foreach (var prod in Model.Productos)
                                {
                                    <option value="@prod.Id">@prod.CodigoSku — @prod.Nombre (Actual: @prod.StockActual u.)</option>
                                }
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Cantidad (Unidades)</label>
                            <input type="number" name="cantidad" min="1" class="form-control" placeholder="Ingrese unidades" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary small">Comprobante o Motivo</label>
                            <textarea name="motivo" class="form-control" rows="2" placeholder="Ej: Remito N° 0004-00018290" required></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">Confirmar Movimiento</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Historial y Existencias por Sucursal -->
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header bg-white d-flex flex-wrap justify-content-between align-items-center gap-2">
                    <h5 class="mb-0 text-dark">Existencias por Sucursal y Semáforo Local</h5>
                    <select id="filtroSucursalTabla" class="form-select form-select-sm w-auto" onchange="filtrarExistenciasSucursal()">
                        <option value="">Todas las sucursales</option>
                        @foreach (var suc in Model.Sucursales)
                        {
                            <option value="@suc.Nombre">@suc.Nombre</option>
                        }
                    </select>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height: 320px;">
                        <table class="table table-hover align-middle mb-0" id="tablaExistenciasSucursal">
                            <thead class="sticky-top">
                                <tr>
                                    <th>Sucursal</th>
                                    <th>SKU</th>
                                    <th>Producto</th>
                                    <th class="text-center">Disponible</th>
                                    <th class="text-center">Punto de Reorden</th>
                                    <th class="text-center">Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var st in Model.StockPorSucursal)
                                {
                                    <tr>
                                        <td class="fw-semibold">@st.SucursalNombre</td>
                                        <td><code>@st.CodigoSku</code></td>
                                        <td>@st.ProductoNombre</td>
                                        <td class="text-center fw-bold">@st.CantidadActual u.</td>
                                        <td class="text-center">@st.PuntoReorden u.</td>
                                        <td class="text-center">
                                            <span class="badge @st.ObtenerClaseBadge()">@st.ObtenerEstadoSemaforo()</span>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-dark">Historial de Auditoría</h5>
                    <span class="badge bg-light text-secondary border">@Model.Movimientos.Count movimientos registrados</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Producto</th>
                                    <th>Sucursal</th>
                                    <th class="text-center">Operación</th>
                                    <th class="text-end">Cantidad</th>
                                    <th>Responsable</th>
                                    <th>Referencia</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var mov in Model.Movimientos)
                                {
                                    var badgeOp = mov.TipoMovimiento == "ENTRADA" ? "bg-success" :
                                                  mov.TipoMovimiento == "SALIDA" ? "bg-danger" : "bg-warning text-dark";
                                    var claseCant = mov.Cantidad >= 0 ? "text-success fw-bold" : "text-danger fw-bold";
                                    var signo = mov.Cantidad >= 0 ? "+" : "";
                                    <tr>
                                        <td class="small text-nowrap">@mov.Fecha.ToString("yyyy-MM-dd HH:mm")</td>
                                        <td class="fw-semibold">@mov.ProductoNombre</td>
                                        <td>@mov.SucursalNombre</td>
                                        <td class="text-center"><span class="badge @badgeOp">@mov.TipoMovimiento</span></td>
                                        <td class="text-end @claseCant">@signo@mov.Cantidad u.</td>
                                        <td><code>@mov.UsuarioNombre</code></td>
                                        <td class="small text-secondary">@mov.Motivo</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        function filtrarExistenciasSucursal() {
            const suc = document.getElementById('filtroSucursalTabla').value.toLowerCase();
            const filas = document.querySelectorAll('#tablaExistenciasSucursal tbody tr');
            filas.forEach(fila => {
                const colSuc = fila.cells[0].innerText.toLowerCase();
                fila.style.display = (suc === '' || colSuc === suc) ? '' : 'none';
            });
        }
    </script>
}
