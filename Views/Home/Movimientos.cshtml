@{
    ViewData["Title"] = "Movimientos de Stock";
}

<div class="container-fluid">
    <div class="mb-4">
        <h2 class="fw-bold mb-1">Movimientos de Stock</h2>
        <p class="text-muted mb-0">Registro de ingresos, despachos y ajustes de inventario por sucursal</p>
    </div>

    <div class="row g-4">
        <!-- Columna Izquierda: Formulario de Nuevo Movimiento -->
        <div class="col-lg-4">
            <div class="card">
                <div class="card-header bg-white">
                    <h5 class="mb-0 text-dark">Registrar Operación</h5>
                </div>
                <div class="card-body">
                    <form onsubmit="event.preventDefault(); alert('Movimiento registrado correctamente.');">
                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Tipo de Operación</label>
                            <select class="form-select" required>
                                <option value="ENTRADA">Entrada de Mercadería</option>
                                <option value="SALIDA">Salida / Despacho</option>
                                <option value="AJUSTE">Ajuste de Inventario</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Sucursal</label>
                            <select class="form-select" required>
                                <option value="1">Central — Av. Corrientes 1234</option>
                                <option value="2">Sucursal Norte — Av. Cabildo 4500</option>
                                <option value="3">Sucursal Sur — Av. Mitre 500</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Producto</label>
                            <select class="form-select" required>
                                <option value="1">Agua Mineral 1.5L</option>
                                <option value="2">Cerveza Lager 1L</option>
                                <option value="3">Arroz Blanco 1kg</option>
                                <option value="4">Fideos Espagueti 500g</option>
                                <option value="5">Leche Entera 1L</option>
                                <option value="6">Lavandina Concentrada 1L</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold text-secondary small">Cantidad</label>
                            <input type="number" min="1" class="form-control" placeholder="Ingrese unidades" required />
                        </div>

                        <div class="mb-4">
                            <label class="form-label fw-semibold text-secondary small">Comprobante o Motivo</label>
                            <textarea class="form-control" rows="2" placeholder="Ej: Remito N° 0004-00018290" required></textarea>
                        </div>

                        <button type="submit" class="btn btn-primary w-100 rounded-pill py-2">Confirmar Movimiento</button>
                    </form>
                </div>
            </div>
        </div>

        <!-- Columna Derecha: Historial y Existencias por Sucursal -->
        <div class="col-lg-8">
            <div class="card mb-4">
                <div class="card-header bg-white">
                    <h5 class="mb-0 text-dark">Existencias por Sucursal</h5>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Sucursal</th>
                                    <th>Producto</th>
                                    <th>Disponible</th>
                                    <th>Punto de Reorden</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td class="fw-semibold">Central</td>
                                    <td>Agua Mineral 1.5L</td>
                                    <td class="fw-bold">90 u.</td>
                                    <td>30 u.</td>
                                    <td><span class="badge bg-success">Óptimo</span></td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Sucursal Norte</td>
                                    <td>Agua Mineral 1.5L</td>
                                    <td class="fw-bold">22 u.</td>
                                    <td>20 u.</td>
                                    <td><span class="badge bg-warning text-dark">Advertencia</span></td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Sucursal Sur</td>
                                    <td>Cerveza Lager 1L</td>
                                    <td class="fw-bold">10 u.</td>
                                    <td>40 u.</td>
                                    <td><span class="badge bg-danger">Crítico</span></td>
                                </tr>
                                <tr>
                                    <td class="fw-semibold">Central</td>
                                    <td>Leche Entera 1L</td>
                                    <td class="fw-bold">15 u.</td>
                                    <td>50 u.</td>
                                    <td><span class="badge bg-danger">Crítico</span></td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card">
                <div class="card-header bg-white d-flex justify-content-between align-items-center">
                    <h5 class="mb-0 text-dark">Historial de Auditoría</h5>
                    <span class="badge bg-light text-secondary border">Últimos movimientos</span>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Fecha</th>
                                    <th>Producto</th>
                                    <th>Sucursal</th>
                                    <th>Operación</th>
                                    <th>Cantidad</th>
                                    <th>Responsable</th>
                                    <th>Referencia</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr>
                                    <td>2026-10-28 14:20</td>
                                    <td class="fw-semibold">Agua Mineral 1.5L</td>
                                    <td>Central</td>
                                    <td><span class="badge bg-success">ENTRADA</span></td>
                                    <td class="fw-bold text-success">+100 u.</td>
                                    <td><code>admin</code></td>
                                    <td>Recepción OC-2026-001</td>
                                </tr>
                                <tr>
                                    <td>2026-10-27 16:40</td>
                                    <td class="fw-semibold">Cerveza Lager 1L</td>
                                    <td>Sucursal Sur</td>
                                    <td><span class="badge bg-danger">SALIDA</span></td>
                                    <td class="fw-bold text-danger">-20 u.</td>
                                    <td><code>operador_sur</code></td>
                                    <td>Despacho Pedido #4412</td>
                                </tr>
                                <tr>
                                    <td>2026-10-26 11:15</td>
                                    <td class="fw-semibold">Leche Entera 1L</td>
                                    <td>Sucursal Norte</td>
                                    <td><span class="badge bg-warning text-dark">AJUSTE</span></td>
                                    <td class="fw-bold text-danger">-5 u.</td>
                                    <td><code>gerente_log</code></td>
                                    <td>Merma por envase dañado</td>
                                </tr>
                                <tr>
                                    <td>2026-10-25 09:00</td>
                                    <td class="fw-semibold">Arroz Blanco 1kg</td>
                                    <td>Central</td>
                                    <td><span class="badge bg-success">ENTRADA</span></td>
                                    <td class="fw-bold text-success">+200 u.</td>
                                    <td><code>admin</code></td>
                                    <td>Recepción OC-2026-002</td>
                                </tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
